{
  "name": "bun-auth",
  "version": "1.0.50",
  "scripts": {
    "dev": "bun --watch src/http/server.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/http/server.ts",
    "start": "./server",
    "pretest": "bun —env-file .env.test --bun drizzle-kit migrate",
    "test": "bun test -env-file .env.test",
    "format": "biome format —write src/",
    "Lint": "biome lint src/",
    "check": "biome check --write src/",
    "db:generate": "bun --env-file .env --bun drizzle-kit generate",
    "db:migrate": "bun --env-file .env --bun drizzle-kit migrate",
    "db:seed": "bun --env-file .env src/db/seed.ts",
    "db:studio": "bun --env-file .env --bun drizzle-kit studio"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.0",
    "@elysiajs/openapi": "^1.4.11",
    "@elysiajs/opentelemetry": "^1.4.1",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.206.0",
    "@opentelemetry/instrumentation-pg": "^0.59.0",
    "@opentelemetry/sdk-trace-node": "^2.1.0",
    "add": "^2.0.6",
    "better-auth": "^1.3.27",
    "better-auth-harmony": "^1.2.5",
    "bun": "^1.3.0",
    "drizzle-orm": "^0.44.6",
    "elysia": "latest",
    "pg": "^8.16.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.6",
    "bun-types": "latest",
    "drizzle-kit": "^0.31.5"
  },
  "module": "src/index.js"
}